# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional
PORT=3000
# Fast model for generating the 3 questions
ANALYZE_MODEL=claude-haiku-5-5
# Stronger model for grading the answers
GRADE_MODEL=claude-sonnet-5-5

# Run without an API key using canned responses (demos and local UI work)
# MOCK_AI=1

# Limits
# Longest accepted CV or vacancy in characters; longer documents are rejected with a clear message, never cut
# MAX_DOC_CHARS=30000
# Longest accepted interview answer in characters; longer answers are rejected with a clear message, never cut
# MAX_ANSWER_CHARS=20000
# Per-request timeout for one Anthropic call, in milliseconds (retried at most once)
# AI_TIMEOUT_MS=120000
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=900000

# Set to 1 when running behind a reverse proxy (Render, Fly, Railway, nginx) so rate limits use the real client IP
# TRUST_PROXY=1
